  <script>
    const incidents=[
      {id:1,name:"Praça Rui Barbosa",place:"Centro · Curitiba",risk:"alto",description:"Exemplo ilustrativo: atenção a possíveis furtos em áreas de grande circulação.",lat:-25.4347,lng:-49.2726},
      {id:2,name:"Terminal Guadalupe",place:"Centro · Curitiba",risk:"alto",description:"Exemplo ilustrativo: redobre a atenção a pertences em pontos de embarque.",lat:-25.4288,lng:-49.2642},
      {id:3,name:"Jardim Botânico",place:"Jardim Botânico · Curitiba",risk:"medio",description:"Exemplo ilustrativo: atenção no deslocamento por vias e acessos próximos.",lat:-25.4416,lng:-49.2389},
      {id:4,name:"Terminal Portão",place:"Portão · Curitiba",risk:"medio",description:"Exemplo ilustrativo: mantenha atenção em horários de maior movimento.",lat:-25.4769,lng:-49.2915},
      {id:5,name:"Parque Barigui",place:"Santo Inácio · Curitiba",risk:"baixo",description:"Exemplo ilustrativo: mantenha os cuidados habituais ao caminhar.",lat:-25.4239,lng:-49.3087},
      {id:6,name:"Centro de São José",place:"São José dos Pinhais · RMC",risk:"baixo",description:"Exemplo ilustrativo: observe o entorno em deslocamentos a pé.",lat:-25.5327,lng:-49.2071}
    ];
    const colors={alto:"#ef4444",medio:"#f97316",baixo:"#10b981"};
    const labels={alto:"Alto",medio:"Médio",baixo:"Baixo"};
    const map=L.map("city-map",{scrollWheelZoom:false}).setView([-25.455,-49.263],11);
    map.attributionControl.setPrefix(false);
    L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png",{maxZoom:19,attribution:'&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap</a> contributors'}).addTo(map);
    const layers={};
    incidents.forEach(item=>{
      const zone=L.circle([item.lat,item.lng],{radius:item.risk==="alto"?950:750,color:colors[item.risk],weight:0,fillColor:colors[item.risk],fillOpacity:.17}).addTo(map);
      const icon=L.divIcon({className:"",html:'<div class="map-pin" style="background:'+colors[item.risk]+'"></div>',iconSize:[28,34],iconAnchor:[14,30]});
      const marker=L.marker([item.lat,item.lng],{icon}).addTo(map).bindPopup("<strong>"+item.name+"</strong><br>"+item.place+" · Risco "+labels[item.risk]+"<br><small>Informação ilustrativa</small>");
      layers[item.id]={zone,marker};
    });
    let selectedFilter="todos";
    function render(){
      const visible=incidents.filter(x=>selectedFilter==="todos"||x.risk===selectedFilter);
      document.getElementById("result-count").textContent=visible.length+" pontos ilustrativos";
      document.getElementById("incident-list").innerHTML=visible.map(x=>'<button type="button" class="incident canva-card" data-id="'+x.id+'" aria-label="Ver '+x.name+' no mapa"><span class="incident-row"><strong>'+x.name+'</strong><span class="badge '+x.risk+' canva-tag">'+labels[x.risk]+'</span></span><span class="place"><i data-lucide="map-pin"></i>'+x.place+'</span><p>'+x.description+'</p></button>').join("");
      incidents.forEach(x=>{const active=visible.includes(x);if(active){layers[x.id].zone.addTo(map);layers[x.id].marker.addTo(map)}else{map.removeLayer(layers[x.id].zone);map.removeLayer(layers[x.id].marker)}});
      lucide.createIcons();
    }
    document.querySelectorAll(".filter").forEach(btn=>btn.addEventListener("click",()=>{selectedFilter=btn.dataset.filter;document.querySelectorAll(".filter").forEach(b=>b.setAttribute("aria-pressed",String(b===btn)));render()}));
    document.getElementById("incident-list").addEventListener("click",e=>{const card=e.target.closest(".incident");if(!card)return;document.querySelectorAll(".incident").forEach(c=>c.classList.toggle("selected",c===card));const x=incidents.find(i=>i.id===Number(card.dataset.id));map.flyTo([x.lat,x.lng],13,{duration:.7});layers[x.id].marker.openPopup();if(innerWidth<950)document.getElementById("city-map").scrollIntoView({behavior:"smooth",block:"center"})});
    render();
    setTimeout(()=>map.invalidateSize(),250);
    const message=document.getElementById("form-message");
    const submit=document.getElementById("submit-alert");
    let sdkReady=false;
    (async()=>{try{const result=await window.dataSdk.init({onDataChanged(){}});sdkReady=result.isOk;if(!sdkReady)message.textContent="Cadastro temporariamente indisponível. Tente novamente mais tarde."}catch(e){message.textContent="Cadastro temporariamente indisponível. Tente novamente mais tarde."}})();
    document.getElementById("signup-form").addEventListener("submit",async e=>{
      e.preventDefault();
      const form=e.currentTarget;
      if(!form.reportValidity())return;
      if(!sdkReady){message.textContent="Não foi possível conectar o cadastro. Tente novamente mais tarde.";return}
      submit.disabled=true;submit.textContent="Enviando...";message.textContent="";
      try{
        const result=await window.dataSdk.create({nome:form.nome.value.trim(),email:form.email.value.trim(),regiao:form.regiao.value,created_at:new Date().toISOString()});
        if(result.isOk){message.textContent="Interesse cadastrado com sucesso. Obrigado!";form.reset()}
        else message.textContent="Não foi possível registrar seu interesse. Tente novamente.";
      }catch(error){message.textContent="Não foi possível registrar seu interesse. Tente novamente."}
      finally{submit.disabled=false;submit.innerHTML='<i data-lucide="arrow-right"></i> Cadastrar interesse';lucide.createIcons()}
    });
  </script>
 </body>
</html>
